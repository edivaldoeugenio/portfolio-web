# ==========================================
# Banco de dados (Prisma)
# ==========================================
# Exemplo com SSL obrigatório para provedores gerenciados
DATABASE_URL="postgresql://usuario:senha@host:5432/database?schema=public&sslmode=require"

# Timeout opcional (ms) para consultas públicas antes do fallback local
DB_QUERY_TIMEOUT_MS="3000"

# ==========================================
# Autenticação (NextAuth)
# ==========================================
# Chave aleatória usada para assinar sessões/tokens
AUTH_SECRET="troque-por-um-segredo-forte"

# URL base da aplicação (produção/local)
NEXTAUTH_URL="http://localhost:3000"

# ==========================================
# Upload de arquivos (AWS S3)
# ==========================================
AWS_REGION="us-west-2"
AWS_BUCKET_NAME="nome-do-bucket"
AWS_FOLDER_PREFIX="suzana/"

# Credenciais AWS (apenas para ambiente local/CI seguro)
AWS_ACCESS_KEY_ID="SUA_ACCESS_KEY"
AWS_SECRET_ACCESS_KEY="SUA_SECRET_KEY"

# Exposição opcional no front-end (somente se necessário)
NEXT_PUBLIC_AWS_BUCKET_NAME="nome-do-bucket"
